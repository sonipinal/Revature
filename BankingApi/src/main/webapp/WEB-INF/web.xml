    <url-pattern>/accounts/update</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>ServletConfigAndContent</display-name>
    <servlet-name>ServletConfigAndContent</servlet-name>
    <servlet-class>com.banking.controller.ServletConfigAndContent</servlet-class>
    <init-param>
      <param-name>config</param-name>
      <param-value>config value</param-value>
      
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>ServletConfigAndContent</servlet-name>
    <url-pattern>/configandcontext</url-pattern>
  </servlet-mapping>
  <context-param>
    <param-name>context</param-name>
    <param-value>context value</param-value>
  </context-param>
