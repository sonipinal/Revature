    <servlet-class>com.banking.controller.HelloWorldServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>HelloWorldServlet</servlet-name>
    <url-pattern>/helloWorld</url-pattern>
  </servlet-mapping>
